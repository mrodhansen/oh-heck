# Path is relative to prisma/ (schema dir), so this is backend/prisma/dev.db
DATABASE_URL=file:./dev.db
PORT=3000
# Reflect any origin (ngrok, phone, GitHub Pages)
CORS_ORIGIN=*
# Default cookie is SameSite=None; Secure so Pages/Vite can stay signed in.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# xAI Grok (scorecard photo import). Optional if OpenCode SuperGrok OAuth is logged in
# (~/.local/share/opencode/auth.json). Prod box has no OpenCode — set a key there.
# XAI_API_KEY=
# XAI_MODEL=grok-4
# OPENCODE_AUTH_PATH=/path/to/opencode/auth.json
