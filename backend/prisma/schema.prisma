generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  SETUP
  BIDDING
  PLAYING
  COMPLETED
}

enum TournamentStatus {
  OPEN
  SEATED
  IN_PROGRESS
  HIGH_TABLE
  COMPLETED
}

enum TournamentStage {
  PRELIM
  HIGH_TABLE
}

enum TournamentTableStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
}

enum GameEventType {
  GAME_CREATED
  BIDS_SET
  TRICKS_SET
  ROUND_UPDATED
}

model Game {
  id         String     @id @default(uuid())
  name       String?
  status     GameStatus @default(BIDDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  finishedAt DateTime?

  /// Denormalized player count at create
  playerCount     Int       @default(0)
  /// Round-1 dealer seat (convention: last seat)
  firstDealerSeat Int       @default(0)
  /// First time bids were committed (play actually started)
  startedAt       DateTime?
  /// finishedAt - createdAt in ms
  durationMs      Int?
  /// Single winner: highest total, then lowest seatIndex on ties (not multi-winner)
  winnerPlayerId  String?
  winnerScore     Int?
  runnerUpScore   Int?
  /// winnerScore - runnerUpScore; null when no runner-up (sole player)
  winMargin       Int?
  totalForceBurns Int       @default(0)
  totalEdits      Int       @default(0)

  /// When set, this game belongs to a tournament table
  tournamentTableId String? @unique
  isHighTable       Boolean @default(false)
  tableNumber       Int?
  tournamentId      String?

  players Player[]
  rounds  Round[]
  events  GameEvent[]

  tournamentTable TournamentTable? @relation(fields: [tournamentTableId], references: [id], onDelete: SetNull)
  tournament      Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([status])
  @@index([finishedAt])
}

model Player {
  id        String   @id @default(uuid())
  gameId    String
  name      String
  seatIndex Int
  createdAt DateTime @default(now())

  /// Link back to tournament roster player when applicable
  tournamentPlayerId String?

  game             Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roundEntries     RoundEntry[]
  tournamentPlayer TournamentPlayer?  @relation(fields: [tournamentPlayerId], references: [id], onDelete: SetNull)

  @@unique([gameId, seatIndex])
  @@unique([gameId, name])
  @@index([gameId])
  @@index([tournamentPlayerId])
}

model Round {
  id         String   @id @default(uuid())
  gameId     String
  number     Int
  handSize   Int
  dealerSeat Int
  forceBurn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Left of dealer — first bidder and first-trick lead
  firstBidderSeat     Int     @default(0)
  dealerPlayerId      String?
  firstBidderPlayerId String?
  /// Seat indices in bid order (left of dealer → dealer last). Json for PG+SQLite portability.
  bidOrderSeats       Json    @default("[]")
  /// Sum of all bids once bidding complete
  bidSum              Int?
  /// handSize - bidSum (positive = table under-bid, negative = over-bid)
  bidDeficit          Int?
  /// Forbidden last-bid value locked when bids completed (null if unrestricted)
  forbiddenLastBid    Int?
  bidsCompletedAt     DateTime?
  tricksCompletedAt   DateTime?
  completedAt         DateTime?
  editCount           Int     @default(0)

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  entries RoundEntry[]

  @@unique([gameId, number])
  @@index([gameId])
}

model RoundEntry {
  id          String   @id @default(uuid())
  roundId     String
  playerId    String
  bid         Int?
  tricksTaken Int?
  points      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 0 = first bidder / first lead; n-1 = dealer (last bidder)
  bidPosition      Int?
  isDealer         Boolean @default(false)
  isFirstBidder    Boolean @default(false)
  isLastBidder     Boolean @default(false)
  /// Sum of bids by players earlier in bid order (at commit time)
  runningBidBefore Int?

  /// tricksTaken == bid
  made       Boolean?
  /// tricksTaken - bid
  trickDelta Int?
  absDelta   Int?
  isNilBid   Boolean?
  isNilMade  Boolean?

  /// Running game total after this round completed
  cumulativeScore   Int?
  placeAfterRound   Int?
  /// Leader total - this total after round (0 if tied for lead or leading)
  scoreBehindLeader Int?

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
  @@index([playerId])
  @@index([made])
  @@index([isDealer])
  @@index([bidPosition])
}

model GameEvent {
  id          String        @id @default(uuid())
  gameId      String
  type        GameEventType
  roundNumber Int?
  /// Full snapshot of the action (bids, tricks, before/after on edits, meta)
  payload     Json
  createdAt   DateTime      @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([gameId, type])
  @@index([type])
}

model Tournament {
  id                String           @id @default(uuid())
  name              String?
  status            TournamentStatus @default(OPEN)
  /// How many players the host expected; grows if more names are added
  targetPlayerCount Int
  preferredTableSize Int             @default(7)
  minTableSize      Int              @default(2)
  maxTableSize      Int              @default(7)
  highTableSize     Int              @default(7)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  seatedAt          DateTime?
  startedAt         DateTime?
  highTableAt       DateTime?
  finishedAt        DateTime?

  players TournamentPlayer[]
  tables  TournamentTable[]
  games   Game[]
}

model TournamentPlayer {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  orderIndex   Int
  createdAt    DateTime @default(now())

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seats      TournamentTableSeat[]
  gamePlayers Player[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

model TournamentTable {
  id           String                @id @default(uuid())
  tournamentId String
  tableNumber  Int
  stage        TournamentStage       @default(PRELIM)
  isHighTable  Boolean               @default(false)
  status       TournamentTableStatus @default(PENDING)
  /// Seat index of first dealer (last in bid order convention after rotate)
  dealerSeat   Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seats      TournamentTableSeat[]
  game       Game?

  @@unique([tournamentId, tableNumber, stage])
  @@index([tournamentId])
}

model TournamentTableSeat {
  id                 String   @id @default(uuid())
  tableId            String
  tournamentPlayerId String
  seatIndex          Int
  /// Qualification metadata for high table (and analytics)
  sourceTableId      String?
  sourceTableNumber  Int?
  sourcePlace        Int?
  sourceScore        Int?
  createdAt          DateTime @default(now())

  table            TournamentTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tournamentPlayer TournamentPlayer @relation(fields: [tournamentPlayerId], references: [id], onDelete: Cascade)

  @@unique([tableId, seatIndex])
  @@unique([tableId, tournamentPlayerId])
  @@index([tournamentPlayerId])
}
