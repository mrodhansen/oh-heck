generator client {
  provider = "prisma-client-js"
}

// SQLite local: `npm run start:dev:sqlite` rewrites provider → sqlite and db-pushes prisma/dev.db.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  SETUP
  BIDDING
  PLAYING
  COMPLETED
}

/// How the game was played / scored.
enum PlayMode {
  /// Physical cards; app is scorekeeper only
  IN_PERSON
  /// Digital multiplayer card table
  ONLINE
}

enum TournamentStatus {
  OPEN
  SEATED
  IN_PROGRESS
  HIGH_TABLE
  COMPLETED
}

enum TournamentStage {
  PRELIM
  HIGH_TABLE
}

enum TournamentTableStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
}

enum GameEventType {
  GAME_CREATED
  BIDS_SET
  TRICKS_SET
  ROUND_UPDATED
  ROUND_DEALT
  CARD_PLAYED
  TRICK_COMPLETED
  BID_PLACED
  PLAYER_LEFT
  SEAT_CLAIMED
  PLAYER_JOINED
  GAME_STARTED_LIVE
  SESSION_CREATED
  SESSION_ENDED
  ROUND_SCORED
  GAME_COMPLETED
}

enum LiveSessionStatus {
  LOBBY
  PLAYING
  COMPLETED
}

/// Optional durable account. Guests still play by display name only.
model User {
  id           String   @id @default(uuid())
  /// Unique, immutable login handle (stored lowercase).
  username     String   @unique
  firstName    String
  lastName     String
  /// Optional, immutable (stored lowercase). Unique when set.
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AuthSession[]
  players  Player[]

  @@index([createdAt])
}

/// Long-lived browser session (cookie token).
model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  /// null = no expiry (cookie set far in the future)
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id         String     @id @default(uuid())
  name       String?
  /// Scorekeeper notes list: [{ id, text, createdAt, updatedAt }]
  notes      Json       @default("[]")
  status     GameStatus @default(BIDDING)
  /// IN_PERSON = scorekeeper; ONLINE = digital card table
  playMode   PlayMode   @default(IN_PERSON)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  finishedAt DateTime?

  /// Denormalized player count at create
  playerCount     Int       @default(0)
  /// Round-1 dealer seat (convention: last seat)
  firstDealerSeat Int       @default(0)
  /// First time bids were committed (play actually started)
  startedAt DateTime?

  /// IN_PERSON scorekeeper records every card and auto-fills tricks
  superScorer Boolean @default(false)

  /// True when imported from a scorecard photo (LLM). False for file import. Null for live/scored games.
  aiImport Boolean?

  /// Tournament high table, or a historical high table from a family log.
  isHighTable Boolean @default(false)

  /// When set, this game belongs to a tournament table
  tournamentTableId String? @unique

  seats  GamePlayer[]
  rounds Round[]
  events GameEvent[]
  tricks Trick[]

  tournamentTable TournamentTable? @relation(fields: [tournamentTableId], references: [id], onDelete: SetNull)
  liveSession     LiveSession?

  @@index([status])
  @@index([finishedAt])
  @@index([playMode])
}

/// Person identity. One row can sit in many games (via GamePlayer).
model Player {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  /// Unique when set — one Player per User.
  userId    String?  @unique

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  seats        GamePlayer[]
  roundEntries RoundEntry[]
  roster       TournamentRoster[]
  tableSeats   TournamentTableSeat[]

  @@index([name])
}

/// A player's seat at one game. Live token/presence live here after kickoff.
model GamePlayer {
  id        String  @id @default(uuid())
  gameId    String
  playerId  String
  seatIndex Int
  /// Live device token. Null for scorekeeper seats.
  token     String? @unique
  isHost    Boolean @default(false)
  gone      Boolean @default(false)

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([gameId, seatIndex])
  @@unique([gameId, playerId])
  @@index([playerId])
  @@index([gameId, gone])
}

model Round {
  id         String   @id @default(uuid())
  gameId     String
  number     Int
  handSize   Int
  dealerSeat Int
  forceBurn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Left of dealer — first bidder and first-trick lead
  firstBidderSeat     Int     @default(0)
  dealerPlayerId      String?
  firstBidderPlayerId String?
  /// Seat indices in bid order (left of dealer → dealer last).
  bidOrderSeats   Json      @default("[]")
  bidsCompletedAt DateTime?
  tricksCompletedAt   DateTime?
  completedAt         DateTime?
  editCount           Int     @default(0)

  /// Optional play-by-play (live + super scorer). Null for bid/trick scorekeeper.
  /// C | D | H | S
  trumpSuit   String?
  /// { s, r } flipped trump card
  trumpCard   Json?
  dealtAt     DateTime?
  /// In-progress trick { leadSeat, plays: [...] } — same shape for live and super
  currentTrick Json?

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  entries RoundEntry[]
  tricks  Trick[]

  @@unique([gameId, number])
  @@index([gameId])
}

model RoundEntry {
  id          String   @id @default(uuid())
  roundId     String
  playerId    String
  bid         Int?
  tricksTaken Int?
  points      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 0 = first bidder / first lead; n-1 = dealer (last bidder)
  bidPosition      Int?
  isDealer         Boolean @default(false)
  isFirstBidder    Boolean @default(false)
  isLastBidder     Boolean @default(false)
  /// Sum of bids by players earlier in bid order (at commit time)
  runningBidBefore Int?

  /// Live: when this seat's bid was placed
  bidPlacedAt DateTime?
  /// Live deal snapshot for this seat [{s,r}, ...]. Null for scorekeeper.
  dealtHand   Json?

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
  @@index([playerId])
  @@index([isDealer])
  @@index([bidPosition])
}

/// One completed trick within a round (online play-by-play).
model Trick {
  id             String   @id @default(uuid())
  gameId         String
  roundId        String
  /// 0-based index within the round
  trickIndex     Int
  leadSeat       Int
  leadSuit       String
  winnerSeat     Int
  winnerPlayerId String?
  completedAt    DateTime @default(now())

  game  Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  plays TrickPlay[]

  @@unique([roundId, trickIndex])
  @@index([gameId])
  @@index([roundId])
  @@index([winnerPlayerId])
}

model TrickPlay {
  id         String   @id @default(uuid())
  trickId    String
  /// 0 = lead
  playOrder  Int
  seatIndex  Int
  playerId   String
  cardSuit   String
  cardRank   String
  /// e.g. AH, TS
  cardKey    String
  followedSuit Boolean @default(true)
  playedTrump  Boolean @default(false)
  playedAt   DateTime @default(now())

  trick Trick @relation(fields: [trickId], references: [id], onDelete: Cascade)

  @@unique([trickId, playOrder])
  @@unique([trickId, seatIndex])
  @@index([playerId])
  @@index([cardKey])
}

model GameEvent {
  id          String        @id @default(uuid())
  gameId      String?
  sessionId   String?
  type        GameEventType
  playerId    String?
  roundNumber Int?
  payload     Json
  createdAt   DateTime      @default(now())

  game    Game?        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  session LiveSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([gameId, createdAt])
  @@index([gameId, type])
  @@index([sessionId, createdAt])
  @@index([type])
  @@index([playerId])
}

model Tournament {
  id                String           @id @default(uuid())
  name              String?
  status            TournamentStatus @default(OPEN)
  /// How many players the host expected; grows if more names are added
  targetPlayerCount Int
  preferredTableSize Int             @default(7)
  minTableSize      Int              @default(2)
  maxTableSize      Int              @default(7)
  highTableSize     Int              @default(7)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  seatedAt          DateTime?
  startedAt         DateTime?
  highTableAt       DateTime?
  finishedAt        DateTime?

  roster TournamentRoster[]
  tables TournamentTable[]
}

/// Tournament field: this Player is on the roster.
model TournamentRoster {
  id           String @id @default(uuid())
  tournamentId String
  playerId     String
  orderIndex   Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
}

model TournamentTable {
  id           String                @id @default(uuid())
  tournamentId String
  tableNumber  Int
  stage        TournamentStage       @default(PRELIM)
  isHighTable  Boolean               @default(false)
  status       TournamentTableStatus @default(PENDING)
  /// Seat index of first dealer (last in bid order convention after rotate)
  dealerSeat   Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seats      TournamentTableSeat[]
  game       Game?

  @@unique([tournamentId, tableNumber, stage])
  @@index([tournamentId])
}

model TournamentTableSeat {
  id                String  @id @default(uuid())
  tableId           String
  playerId          String
  seatIndex         Int
  sourceTableId     String?
  sourceTableNumber Int?
  sourcePlace       Int?
  sourceScore       Int?
  createdAt         DateTime @default(now())

  table  TournamentTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  player Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tableId, seatIndex])
  @@unique([tableId, playerId])
  @@index([playerId])
}

/// Online table presence (lobby, join code, host). Score lives on Game.
/// Lobby sitters are JSON until kickoff — Player rows are created at start.
model LiveSession {
  id           String            @id @default(uuid())
  code         String            @unique
  status       LiveSessionStatus @default(LOBBY)
  hostPlayerId String?
  /// Linked scorecard once play starts
  gameId       String?           @unique
  /// Pre-start sitters: [{ id, name, token, seatIndex, isHost, gone, userId }]
  lobby        Json              @default("[]")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  events GameEvent[]
  game   Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}
