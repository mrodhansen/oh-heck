generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  SETUP
  BIDDING
  PLAYING
  COMPLETED
}

/// How the game was played / scored.
enum PlayMode {
  /// Physical cards; app is scorekeeper only
  IN_PERSON
  /// Digital multiplayer card table
  ONLINE
}

enum TournamentStatus {
  OPEN
  SEATED
  IN_PROGRESS
  HIGH_TABLE
  COMPLETED
}

enum TournamentStage {
  PRELIM
  HIGH_TABLE
}

enum TournamentTableStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
}

enum GameEventType {
  GAME_CREATED
  BIDS_SET
  TRICKS_SET
  ROUND_UPDATED
  /// Online: round dealt (hands + trump snapshot)
  ROUND_DEALT
  /// Online: single card play
  CARD_PLAYED
  /// Online: trick resolved
  TRICK_COMPLETED
  /// Online: individual bid placed
  BID_PLACED
  /// Online: seat left / claimed / joined mid-game
  PLAYER_LEFT
  SEAT_CLAIMED
  PLAYER_JOINED
  GAME_STARTED_LIVE
}

enum LiveSessionStatus {
  LOBBY
  PLAYING
  COMPLETED
}

model Game {
  id         String     @id @default(uuid())
  name       String?
  status     GameStatus @default(BIDDING)
  /// IN_PERSON = scorekeeper; ONLINE = digital card table
  playMode   PlayMode   @default(IN_PERSON)
  /// Join code when playMode = ONLINE (denormalized for analytics)
  liveCode   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  finishedAt DateTime?

  /// Denormalized player count at create
  playerCount     Int       @default(0)
  /// Round-1 dealer seat (convention: last seat)
  firstDealerSeat Int       @default(0)
  /// First time bids were committed (play actually started)
  startedAt       DateTime?
  /// finishedAt - createdAt in ms
  durationMs      Int?
  /// Single winner: highest total, then lowest seatIndex on ties (not multi-winner)
  winnerPlayerId  String?
  winnerScore     Int?
  runnerUpScore   Int?
  /// winnerScore - runnerUpScore; null when no runner-up (sole player)
  winMargin       Int?
  totalForceBurns Int       @default(0)
  totalEdits      Int       @default(0)

  /// When set, this game belongs to a tournament table
  tournamentTableId String? @unique
  isHighTable       Boolean @default(false)
  tableNumber       Int?
  tournamentId      String?

  players    Player[]
  rounds     Round[]
  events     GameEvent[]
  tricks     Trick[]
  liveEvents LiveEvent[]

  tournamentTable TournamentTable? @relation(fields: [tournamentTableId], references: [id], onDelete: SetNull)
  tournament      Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  liveSession     LiveSession?

  @@index([tournamentId])
  @@index([status])
  @@index([finishedAt])
  @@index([playMode])
  @@index([liveCode])
}

model Player {
  id        String   @id @default(uuid())
  gameId    String
  name      String
  seatIndex Int
  createdAt DateTime @default(now())

  /// Link back to tournament roster player when applicable
  tournamentPlayerId String?

  game             Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roundEntries     RoundEntry[]
  tournamentPlayer TournamentPlayer?  @relation(fields: [tournamentPlayerId], references: [id], onDelete: SetNull)

  @@unique([gameId, seatIndex])
  @@unique([gameId, name])
  @@index([gameId])
  @@index([tournamentPlayerId])
}

model Round {
  id         String   @id @default(uuid())
  gameId     String
  number     Int
  handSize   Int
  dealerSeat Int
  forceBurn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Left of dealer — first bidder and first-trick lead
  firstBidderSeat     Int     @default(0)
  dealerPlayerId      String?
  firstBidderPlayerId String?
  /// Seat indices in bid order (left of dealer → dealer last). Json for PG+SQLite portability.
  bidOrderSeats       Json    @default("[]")
  /// Sum of all bids once bidding complete
  bidSum              Int?
  /// handSize - bidSum (positive = table under-bid, negative = over-bid)
  bidDeficit          Int?
  /// Forbidden last-bid value locked when bids completed (null if unrestricted)
  forbiddenLastBid    Int?
  bidsCompletedAt     DateTime?
  tricksCompletedAt   DateTime?
  completedAt         DateTime?
  editCount           Int     @default(0)

  /// Online card data (null for in-person scorekeeper)
  /// C | D | H | S
  trumpSuit   String?
  /// { s, r } flipped trump card
  trumpCard   Json?
  /// Snapshot at deal: { bySeat: Card[][], byPlayerId: Record<playerId, Card[]> }
  dealtHands  Json?
  dealtAt     DateTime?
  /// Full trick log mirror (same data as Trick rows) for easy export
  trickHistory Json?

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  entries RoundEntry[]
  tricks  Trick[]

  @@unique([gameId, number])
  @@index([gameId])
}

model RoundEntry {
  id          String   @id @default(uuid())
  roundId     String
  playerId    String
  bid         Int?
  tricksTaken Int?
  points      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 0 = first bidder / first lead; n-1 = dealer (last bidder)
  bidPosition      Int?
  isDealer         Boolean @default(false)
  isFirstBidder    Boolean @default(false)
  isLastBidder     Boolean @default(false)
  /// Sum of bids by players earlier in bid order (at commit time)
  runningBidBefore Int?

  /// tricksTaken == bid
  made       Boolean?
  /// tricksTaken - bid
  trickDelta Int?
  absDelta   Int?
  isNilBid   Boolean?
  isNilMade  Boolean?

  /// Running game total after this round completed
  cumulativeScore   Int?
  placeAfterRound   Int?
  /// Leader total - this total after round (0 if tied for lead or leading)
  scoreBehindLeader Int?

  /// Online: when this seat's bid was placed
  bidPlacedAt DateTime?
  /// Online: dealt hand snapshot for this seat [{s,r}, ...]
  dealtHand   Json?
  /// Online: cards this seat played in order this round [{trickIndex, playOrder, s, r}, ...]
  cardsPlayed Json?

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
  @@index([playerId])
  @@index([made])
  @@index([isDealer])
  @@index([bidPosition])
}

/// One completed trick within a round (online play-by-play).
model Trick {
  id             String   @id @default(uuid())
  gameId         String
  roundId        String
  /// 0-based index within the round
  trickIndex     Int
  leadSeat       Int
  leadSuit       String
  winnerSeat     Int
  winnerPlayerId String?
  completedAt    DateTime @default(now())

  game  Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  plays TrickPlay[]

  @@unique([roundId, trickIndex])
  @@index([gameId])
  @@index([roundId])
  @@index([winnerPlayerId])
}

model TrickPlay {
  id         String   @id @default(uuid())
  trickId    String
  /// 0 = lead
  playOrder  Int
  seatIndex  Int
  playerId   String
  cardSuit   String
  cardRank   String
  /// e.g. AH, TS
  cardKey    String
  followedSuit Boolean @default(true)
  playedTrump  Boolean @default(false)
  playedAt   DateTime @default(now())

  trick Trick @relation(fields: [trickId], references: [id], onDelete: Cascade)

  @@unique([trickId, playOrder])
  @@unique([trickId, seatIndex])
  @@index([playerId])
  @@index([cardKey])
}

/// High-frequency online session telemetry (join/leave/bid/play/deal).
model LiveEvent {
  id          String   @id @default(uuid())
  sessionId   String?
  gameId      String?
  type        String
  playerId    String?
  roundNumber Int?
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  game    Game?        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  session LiveSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([gameId, createdAt])
  @@index([type])
  @@index([playerId])
}

model GameEvent {
  id          String        @id @default(uuid())
  gameId      String
  type        GameEventType
  roundNumber Int?
  /// Full snapshot of the action (bids, tricks, before/after on edits, meta)
  payload     Json
  createdAt   DateTime      @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([gameId, type])
  @@index([type])
}

model Tournament {
  id                String           @id @default(uuid())
  name              String?
  status            TournamentStatus @default(OPEN)
  /// How many players the host expected; grows if more names are added
  targetPlayerCount Int
  preferredTableSize Int             @default(7)
  minTableSize      Int              @default(2)
  maxTableSize      Int              @default(7)
  highTableSize     Int              @default(7)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  seatedAt          DateTime?
  startedAt         DateTime?
  highTableAt       DateTime?
  finishedAt        DateTime?

  players TournamentPlayer[]
  tables  TournamentTable[]
  games   Game[]
}

model TournamentPlayer {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  orderIndex   Int
  createdAt    DateTime @default(now())

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seats      TournamentTableSeat[]
  gamePlayers Player[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

model TournamentTable {
  id           String                @id @default(uuid())
  tournamentId String
  tableNumber  Int
  stage        TournamentStage       @default(PRELIM)
  isHighTable  Boolean               @default(false)
  status       TournamentTableStatus @default(PENDING)
  /// Seat index of first dealer (last in bid order convention after rotate)
  dealerSeat   Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seats      TournamentTableSeat[]
  game       Game?

  @@unique([tournamentId, tableNumber, stage])
  @@index([tournamentId])
}

model TournamentTableSeat {
  id                 String   @id @default(uuid())
  tableId            String
  tournamentPlayerId String
  seatIndex          Int
  /// Qualification metadata for high table (and analytics)
  sourceTableId      String?
  sourceTableNumber  Int?
  sourcePlace        Int?
  sourceScore        Int?
  createdAt          DateTime @default(now())

  table            TournamentTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tournamentPlayer TournamentPlayer @relation(fields: [tournamentPlayerId], references: [id], onDelete: Cascade)

  @@unique([tableId, seatIndex])
  @@unique([tableId, tournamentPlayerId])
  @@index([tournamentPlayerId])
}

/// Online multiplayer card table (lobby + live play). Separate from scorekeeper Game.
model LiveSession {
  id           String            @id @default(uuid())
  code         String            @unique
  status       LiveSessionStatus @default(LOBBY)
  hostPlayerId String?
  /// Linked scorekeeper game once play starts
  gameId       String?           @unique
  /// Full engine state (hands, tricks, bids). Server-only source of truth.
  state        Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  players LivePlayer[]
  events  LiveEvent[]
  game    Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

model LivePlayer {
  id        String   @id @default(uuid())
  sessionId String
  name      String
  /// Seat assigned at join; host is always last seat when game starts (reindexed).
  seatIndex Int
  /// Secret device token — proves seat ownership
  token     String
  isHost    Boolean  @default(false)
  /// Left the table; seat held for reclaim while game is active
  gone      Boolean  @default(false)
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, name])
  @@unique([sessionId, seatIndex])
  @@unique([sessionId, token])
  @@index([sessionId])
  @@index([sessionId, gone])
}
