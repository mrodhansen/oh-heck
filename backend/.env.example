# --- Postgres (Docker db / full stack) ---
DATABASE_URL=postgresql://ohheck:ohheck@localhost:5433/ohheck?schema=public
PORT=3000
# * reflects any Origin (needed for GitHub Pages / o-heck.com → ngrok).
# A single local origin like http://localhost:5173 will block hosted clients.
CORS_ORIGIN=*
# Cross-origin PWA (Pages / Vite → API) needs None; Lax will look signed-in
# until refresh, then /auth/me has no cookie.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# xAI Grok (scorecard photo import). Optional if OpenCode SuperGrok OAuth is logged in
# (~/.local/share/opencode/auth.json). Prod box has no OpenCode — set a key there.
# XAI_API_KEY=
# XAI_MODEL=grok-4
# OPENCODE_AUTH_PATH=/path/to/opencode/auth.json
